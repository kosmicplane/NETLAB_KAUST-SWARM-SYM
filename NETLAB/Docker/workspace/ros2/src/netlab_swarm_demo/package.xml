<?xml version="1.0"?>
<package format="3">
  <name>netlab_swarm_demo</name>
  <version>9.0.0</version>
  <description>NETLAB communication-gated SNaaS packet runtime integrating Isaac Sim, ROS 2 Jazzy, and Sionna link metrics.</description>
  <maintainer email="netlab@example.com">NETLAB Research Platform</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>netlab_interfaces</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
