{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netlab.local/schemas/plugin/plugin-manifest-v1.schema.json",
  "title": "NETLAB Researcher Algorithm Manifest API 2.0",
  "type": "object",
  "required": [
    "algorithm_id",
    "name",
    "version",
    "api_version",
    "category",
    "entrypoint",
    "execution_mode",
    "resource_budget",
    "parameter_schema",
    "observation_schema",
    "action_schema",
    "safety_fallback"
  ],
  "properties": {
    "algorithm_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,63}$"},
    "plugin_id": {"type": "string"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
    "api_version": {"const": "2.0"},
    "category": {
      "enum": [
        "controller", "trajectory_planner", "formation_controller", "topology_generator",
        "routing_policy", "recovery_policy", "standby_selector", "propagation_model",
        "antenna_model", "traffic_generator", "scheduler", "energy_model", "metric",
        "optimizer", "safety_filter", "marl_policy", "import_export_adapter"
      ]
    },
    "entrypoint": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "execution_mode": {"enum": ["isolated_python", "external_ros2", "oci_container", "pettingzoo_parallel", "replay"]},
    "author": {"type": "string"},
    "organization": {"type": "string"},
    "license": {"type": "string"},
    "description": {"type": "string"},
    "citations": {"type": "array", "items": {"type": "object"}},
    "supported_fidelity_profiles": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "required_state_fields": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "required_ros_interfaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "observation_schema": {"type": "object"},
    "action_schema": {"type": "object"},
    "parameter_schema": {"type": "object"},
    "resource_budget": {
      "type": "object",
      "required": ["timeout_s", "memory_mb", "cpu_cores", "output_kb", "network_policy"],
      "properties": {
        "timeout_s": {"type": "number", "minimum": 0.001, "maximum": 300},
        "memory_mb": {"type": "integer", "minimum": 16, "maximum": 131072},
        "cpu_cores": {"type": "number", "minimum": 0.05, "maximum": 128},
        "output_kb": {"type": "integer", "minimum": 8, "maximum": 1048576},
        "gpu_required": {"type": "boolean"},
        "network_policy": {"enum": ["deny", "loopback", "experiment_network"]}
      },
      "additionalProperties": false
    },
    "deterministic_seed": {"type": "boolean"},
    "checkpoint_contract": {"type": "object"},
    "safety_fallback": {"type": "string", "minLength": 1},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "validity_domain": {"type": "string"},
    "known_limitations": {"type": "array", "items": {"type": "string"}},
    "source_hash": {"type": "string"},
    "dependency_lock_hash": {"type": "string"}
  },
  "additionalProperties": true
}
