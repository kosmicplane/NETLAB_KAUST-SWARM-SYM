{
  "action_schema": {
    "additionalProperties": true,
    "type": "object"
  },
  "algorithm_id": "voronoi_coverage_controller",
  "api_version": "2.0",
  "assumptions": [
    "Local ENU coordinate frame",
    "NETLAB safety and communication-feasibility shield remains authoritative"
  ],
  "author": "NETLAB Research Team",
  "category": "formation_controller",
  "checkpoint_contract": {
    "supported": false
  },
  "citations": [
    {
      "authors": "Cortes, Martinez, Karatas, Bullo",
      "doi": "10.1109/TRA.2004.824698",
      "title": "Coverage Control for Mobile Sensing Networks",
      "year": 2004
    }
  ],
  "description": "Weighted Lloyd/Voronoi-style coverage baseline with connectivity enforced by the shield.",
  "deterministic_seed": true,
  "entrypoint": "algorithm.py",
  "execution_mode": "isolated_python",
  "hooks": [
    "initialize",
    "validate",
    "reset",
    "step",
    "plan_positions",
    "plan_velocities",
    "plan_trajectories",
    "on_state_update",
    "on_topology_update",
    "on_link_update",
    "on_failure",
    "select_standby",
    "recompute_topology",
    "compute_metric",
    "shutdown"
  ],
  "known_limitations": [
    "Reference implementation prioritizes reproducibility and traceability over exact reproduction of every solver detail."
  ],
  "license": "MIT",
  "name": "Voronoi Coverage Controller",
  "observation_schema": {
    "required": [
      "uavs",
      "topology",
      "constraints"
    ],
    "type": "object"
  },
  "organization": "NETLAB",
  "parameter_schema": {
    "additionalProperties": false,
    "properties": {
      "altitude_m": {
        "default": 35,
        "maximum": 120,
        "minimum": 10,
        "type": "number"
      },
      "lloyd_gain": {
        "default": 0.5,
        "maximum": 1,
        "minimum": 0.01,
        "type": "number"
      },
      "sample_count": {
        "default": 64,
        "maximum": 10000,
        "minimum": 8,
        "type": "integer"
      }
    },
    "type": "object"
  },
  "parameters": {
    "altitude_m": {
      "default": 35,
      "maximum": 120,
      "minimum": 10,
      "type": "number"
    },
    "lloyd_gain": {
      "default": 0.5,
      "maximum": 1,
      "minimum": 0.01,
      "type": "number"
    },
    "sample_count": {
      "default": 64,
      "maximum": 10000,
      "minimum": 8,
      "type": "integer"
    }
  },
  "plugin_id": "voronoi_coverage_controller",
  "required_ros_interfaces": [
    "/netlab/algorithm/action",
    "/netlab/algorithm/status"
  ],
  "required_state_fields": [
    "uavs",
    "topology",
    "links",
    "constraints"
  ],
  "resource_budget": {
    "cpu_cores": 1.0,
    "gpu_required": false,
    "memory_mb": 1024,
    "network_policy": "deny",
    "output_kb": 512,
    "timeout_s": 1.0
  },
  "safety_fallback": "hold_position",
  "supported_fidelity_profiles": [
    "F1_ANALYTICAL",
    "F2_STOCHASTIC"
  ],
  "timeout_s": 1.0,
  "validity_domain": "Centroidal coverage reference on local service regions.",
  "version": "1.0.0"
}
